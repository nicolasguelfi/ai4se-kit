{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "permission": {
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*/.ssh/*": "deny",
      "*/.aws/*": "deny",
      "*/.gnupg/*": "deny",
      "*/.config/opencode/*": "deny",
      "*/.local/share/opencode/*": "deny",
      "*/.git/config": "deny",
      "*/.netrc": "deny",
      "*credentials*": "deny"
    },
    "bash": {
      "*.env*": "deny",
      "*.env.example*": "allow",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "git push *": "ask",
      "sudo *": "ask",
      "rm -rf *": "ask",
      "rm -r *": "ask",
      "npm install -g *": "ask",
      "npm i -g *": "ask",
      "pip install *": "ask",
      "pip3 install *": "ask",
      "curl *": "ask",
      "wget *": "ask"
    }
  }
}
